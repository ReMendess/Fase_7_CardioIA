# CardioIA — Fase 7 — frontend (Etapa D) | variaveis de ambiente
# ---------------------------------------------------------------------------
# Copie para ".env.local" e ajuste se necessario.
# O arquivo ".env.local" esta no .gitignore: NUNCA versione credenciais.
#
# Este arquivo NAO contem valores reais - apenas os NOMES das variaveis.
# ---------------------------------------------------------------------------

# URL base da API (inclui o prefixo /api/v1).
# Desenvolvimento local (padrao quando ausente): http://127.0.0.1:8000/api/v1
# Producao (Vercel): defina na interface da Vercel apontando para o backend no Render,
#   ex.: VITE_API_URL=https://cardioia-backend.onrender.com/api/v1
# A origem do frontend precisa estar em CORS_ORIGENS no backend.
VITE_API_URL=http://127.0.0.1:8000/api/v1
