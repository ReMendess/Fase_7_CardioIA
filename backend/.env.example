# CardioIA - Fase 7 - backend central | variaveis de ambiente
# ---------------------------------------------------------------------------
# Copie para ".env" e preencha APENAS localmente.
# O arquivo ".env" esta no .gitignore: NUNCA versione segredos.
#
# Este arquivo NAO contem valores reais - apenas os NOMES das variaveis.
# ---------------------------------------------------------------------------

# --- OBRIGATORIA -----------------------------------------------------------
# Assinatura dos tokens JWT (HS256 exige >= 32 caracteres = 256 bits).
# Gere um valor local com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Opcionais (padroes abaixo) -------------------------------------------
AMBIENTE=desenvolvimento
HOST=127.0.0.1
PORTA=8000

JWT_ALGORITMO=HS256
ACCESS_TOKEN_MINUTOS=30
REFRESH_TOKEN_DIAS=7

# Item 2 da Etapa C (persistencia)
DATABASE_URL=sqlite:///./cardioia.db

# Origens permitidas no CORS (lista separada por virgula).
# Os dois nomes de host entram de proposito: o Vite pode servir em `localhost` OU em
# `127.0.0.1`, e o navegador trata os dois como origens DIFERENTES — sem ambos, o
# frontend abre mas todas as chamadas sao bloqueadas.
CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Padrao (regex) de origens adicionais. VAZIO por padrao — sem enfraquecimento implicito.
# Util em hospedagem que gera uma URL nova por deploy (a Vercel cria um dominio a cada
# preview). Sugestao para este projeto:
# CORS_ORIGEM_REGEX=^https://.*\.vercel\.app$
CORS_ORIGEM_REGEX=

# Caminho da Fase 6 (onde estao data/ e models/). Vazio = descoberta automatica.
PASTA_FASE_6=

# --- Conta de demonstracao (semeada no startup) ---------------------------
# Em hospedagem gratuita o sistema de arquivos e efemero: o SQLite volta vazio a cada
# reinicio. Com SEMEAR_USUARIO_INICIAL=true, o servidor cria a conta abaixo quando o
# banco ainda nao tem nenhum usuario — assim a aplicacao publicada continua acessivel.
# E idempotente: se ja houver usuario, nao faz nada.
SEMEAR_USUARIO_INICIAL=true
USUARIO_INICIAL_NOME=Usuario de Demonstracao
USUARIO_INICIAL_EMAIL=teste
USUARIO_INICIAL_SENHA=senhaTeste23@
# Papel do RBAC: ADMIN, MEDICO ou OPERADOR.
USUARIO_INICIAL_PAPEL=MEDICO

# Item 4 da Etapa C (integracao com a Fase 6)
# Carrega o artefato no startup (evita pagar ~6 s de import na 1a requisicao do usuario).
# O boot fica ~7 s mais lento. "false" em desenvolvimento se preferir subir rapido.
AQUECER_MODELO_NO_STARTUP=true

# Item 5 da Etapa C (telemetria IoT - Fase 3)
# Chave compartilhada dos dispositivos, enviada no cabecalho "X-Device-Key".
# Vazio = desabilitada: a ingestao passa a exigir usuario com papel OPERADOR.
# SEGREDO: gere um valor local e nunca versione.
IOT_DEVICE_KEY=

# --- Telemetria simulada (semeada no startup) ------------------------------
# Mesma motivacao da conta de demonstracao, agravada por um fator: alem de o SQLite da
# hospedagem gratuita voltar vazio a cada reinicio, NAO HA DISPOSITIVO publicando na
# nuvem. Com "true", o servidor grava algumas leituras de exemplo quando a tabela de
# telemetria esta vazia — assim a aba Monitoramento nao fica vazia na aplicacao publicada.
#
# As leituras entram com origem_transporte="simulado" (valor do contrato), e a interface
# as rotula como "Simulado": nenhuma e apresentada como medicao de dispositivo real.
# Idempotente: se ja houver qualquer leitura, nao faz nada.
SEMEAR_TELEMETRIA_SIMULADA=true

# Item 6 da Etapa C (visao computacional - servico isolado da Fase 4)
SERVICO_VISAO_URL=http://localhost:5001
# Token de servico enviado como X-Service-Token (opcional: o servico legado nao valida
# nada hoje; existe para quando houver proxy autenticado na frente). SEGREDO: nao versione.
SERVICO_VISAO_TOKEN=
# Prazo da chamada ao servico, em segundos (o 1o predict carrega o TensorFlow).
SERVICO_VISAO_TIMEOUT_SEGUNDOS=30
# Teto de upload de imagem, em MB (exceder devolve 413 LIMITE_EXCEDIDO).
LIMITE_DE_UPLOAD_MB=10

# --- Somente quando o recurso for usado (nunca versionar valores) ---------
# Item 4 da Etapa C - modo real do pipeline multiagente (Fase 6)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Item 7 da Etapa C - assistente conversacional (Fase 5)
# O backend le SOMENTE destas variaveis: NAO usa os valores default do IBM_API.py da Fase 5
# (que contem a chave real do projeto versionada - achado S1 / correcao C1).
WATSON_API_KEY=
WATSON_SERVICE_URL=
WATSON_ASSISTANT_ID=
WATSON_ENVIRONMENT_ID=
# Prazo da chamada ao Watson, em segundos (mesmo valor de WATSON_TIMEOUT na Fase 5).
WATSON_TIMEOUT_SEGUNDOS=30
